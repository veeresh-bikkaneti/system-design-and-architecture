{
  "name": "system-design-mastery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/seo/generate-manifest.mjs",
    "prebuild": "node scripts/seo/generate-manifest.mjs && node scripts/seo/generate-sitemap.mjs && node scripts/seo/generate-llms-txt.mjs",
    "build": "tsc -b && vite build && node scripts/seo/prerender.mjs",
    "content:check": "python3 scripts/check_mdx_h1.py",
    "content:validate": "python3 scripts/validate_lessons.py",
    "test": "vitest run",
    "pretest": "node scripts/seo/generate-manifest.mjs",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "dompurify": "^3.4.15",
    "mermaid": "^11.17.2",
    "motion": "^13.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
