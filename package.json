{
  "name": "system-design-mastery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/seo/generate-manifest.mjs && node scripts/ben/build-index.mjs --optional",
    "prebuild": "node scripts/seo/generate-manifest.mjs && node scripts/seo/generate-sitemap.mjs && node scripts/seo/generate-feed.mjs && node scripts/seo/generate-llms-txt.mjs && node scripts/seo/generate-og-images.mjs && node scripts/ben/build-index.mjs",
    "build": "tsc -b && vite build && node scripts/seo/prerender.mjs && node scripts/seo/check-snapshot-budget.mjs",
    "seo:budget": "node scripts/seo/check-snapshot-budget.mjs",
    "content:check": "python3 scripts/check_mdx_h1.py",
    "content:validate": "python3 scripts/validate_lessons.py",
    "narration:index": "python3 scripts/tts/generate_narration_index.py",
    "test": "vitest run",
    "pretest": "node scripts/seo/generate-manifest.mjs",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview",
    "ben:index": "node scripts/ben/build-index.mjs",
    "eval:ben": "vitest run --config vitest.eval.config.ts; status=$?; cat evals/ben/REPORT.md; exit $status"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@mlc-ai/web-llm": "^0.2.85",
    "dompurify": "^3.4.16",
    "mermaid": "^12.0.0",
    "motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.2.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "satori": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "fflate": "0.7.5",
    "lodash-es": "4.18.1"
  }
}
