.925, "end": 260.75}]}, {"index": 28, "kind": "prose", "text": "CAP's C means linearizability — every read sees the latest completed write, as if there were only one copy — which is a different idea from ACID's C (transactions preserve your data's rules). Same word, different meaning entirely.", "start": 261.05, "end": 276.925, "words": [{"text": "CAP's", "start": 261.35, "end": 261.963}, {"text": "C", "start": 261.963, "end": 262.225}, {"text": "means", "start": 262.225, "end": 262.562}, {"text": "linearizability", "start": 262.562, "end": 263.9}, {"text": "every", "start": 263.9, "end": 264.375}, {"text": "read", "start": 264.375, "end": 264.675}, {"text": "sees", "start": 264.675, "end": 264.975}, {"text": "the", "start": 264.975, "end": 265.1}, {"text": "latest", "start": 265.1, "end": 265.5}, {"text": "completed", "start": 265.5, "end": 266.025}, {"text": "write", "start": 266.025, "end": 266.55}, {"text": "as", "start": 266.55, "end": 266.8}, {"text": "if", "start": 266.8, "end": 266.925}, {"text": "there", "start": 266.925, "end": 267.062}, {"text": "were", "start": 267.062, "end": 267.2}, {"text": "only", "start": 267.2, "end": 267.5}, {"text": "one", "start": 267.5, "end": 267.725}, {"text": "copy", "start": 267.725, "end": 268.512}, {"text": "which", "start": 268.512, "end": 268.8}, {"text": "is", "start": 268.8, "end": 268.913}, {"text": "a", "start": 268.913, "end": 268.975}, {"text": "different", "start": 268.975, "end": 269.288}, {"text": "idea", "start": 269.288, "end": 269.725}, {"text": "from", "start": 269.725, "end": 269.938}, {"text": "ACID's", "start": 269.938, "end": 270.387}, {"text": "C", "start": 270.387, "end": 270.975}, {"text": "transactions", "start": 270.975, "end": 271.863}, {"text": "preserve", "start": 271.863, "end": 272.288}, {"text": "your", "start": 272.288, "end": 272.4}, {"text": "data's", "start": 272.4, "end": 272.8}, {"text": "rules", "start": 272.8, "end": 273.7}, {"text": "Same", "start": 273.7, "end": 274.425}, {"text": "