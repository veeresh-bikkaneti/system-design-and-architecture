.725, "end": 65.825}, {"text": "need", "start": 65.825, "end": 66.062}, {"text": "shared", "start": 66.062, "end": 66.388}, {"text": "plumbing", "start": 66.388, "end": 67.0}, {"text": "shared", "start": 67.0, "end": 67.425}, {"text": "seating", "start": 67.425, "end": 68.025}, {"text": "and", "start": 68.025, "end": 68.213}, {"text": "a", "start": 68.213, "end": 68.275}, {"text": "directory", "start": 68.275, "end": 68.9}, {"text": "so", "start": 68.9, "end": 69.075}, {"text": "customers", "start": 69.075, "end": 69.65}, {"text": "can", "start": 69.65, "end": 69.825}, {"text": "find", "start": 69.825, "end": 70.088}, {"text": "the", "start": 70.088, "end": 70.175}, {"text": "dumplings", "start": 70.175, "end": 70.975}]}, {"index": 5, "kind": "prose", "text": "What each buys you", "start": 71.225, "end": 73.025, "words": [{"text": "What", "start": 71.55, "end": 71.675}, {"text": "each", "start": 71.675, "end": 71.9}, {"text": "buys", "start": 71.9, "end": 72.25}, {"text": "you", "start": 72.25, "end": 72.675}]}, {"index": 6, "kind": "prose", "text": "Monolith strengths: one codebase to understand, one deployment pipeline, function calls instead of network calls (no serialization, no partial failure, no latency), trivial refactoring across boundaries, and transactions that actually work (see Distributed Transactions for what you give up). Debugging is pleasant — the stack trace is right there.", "start": 73.025, "end": 95.125, "words": [{"text": "Monolith", "start": 73.35, "end": 73.85}, {"text": "strengths", "start": 73.85, "end": 74.7}, {"text": "one", "start": 74.7, "end": 75.088}, {"text": "codebase", "start": 75.088, "end": 75.625}, {"text": "to", "start": 75.625, "end": 75.713}, {"text": "understand", "start": 75.713, "end": 76.475}, {"text": "one", "start": 76.475, "end": 76.825}, {"text": "deployment", "start": 76.825, "end": 77.275}, {"text": "pipeline", "start": 77.275, "end": 78.0}, {"text": "function", "start": 78.0, "end": 78.55}, {"text": "calls", "star