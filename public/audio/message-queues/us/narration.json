xt": "within", "start": 158.875, "end": 159.087}, {"text": "a", "start": 159.087, "end": 159.15}, {"text": "partition", "start": 159.15, "end": 159.762}, {"text": "or", "start": 159.762, "end": 159.938}, {"text": "queue", "start": 159.938, "end": 160.4}, {"text": "not", "start": 160.4, "end": 160.75}, {"text": "globally", "start": 160.75, "end": 161.7}, {"text": "Kafka's", "start": 161.7, "end": 162.325}, {"text": "model", "start": 162.325, "end": 162.75}, {"text": "is", "start": 162.75, "end": 162.9}, {"text": "the", "start": 162.9, "end": 163.0}, {"text": "clearest", "start": 163.0, "end": 163.825}, {"text": "a", "start": 163.825, "end": 164.062}, {"text": "topic", "start": 164.062, "end": 164.5}, {"text": "is", "start": 164.5, "end": 164.637}, {"text": "split", "start": 164.637, "end": 164.912}, {"text": "into", "start": 164.912, "end": 165.1}, {"text": "partitions", "start": 165.1, "end": 166.025}, {"text": "each", "start": 166.025, "end": 166.362}, {"text": "an", "start": 166.362, "end": 166.487}, {"text": "ordered", "start": 166.487, "end": 166.9}, {"text": "log", "start": 166.9, "end": 167.575}, {"text": "messages", "start": 167.575, "end": 168.275}, {"text": "with", "start": 168.275, "end": 168.412}, {"text": "the", "start": 168.412, "end": 168.537}, {"text": "same", "start": 168.537, "end": 168.887}, {"text": "key", "start": 168.887, "end": 169.25}, {"text": "always", "start": 169.25, "end": 169.675}, {"text": "land", "start": 169.675, "end": 170.05}, {"text": "in", "start": 170.05, "end": 170.137}, {"text": "the", "start": 170.137, "end": 170.237}, {"text": "same", "start": 170.237, "end": 170.5}, {"text": "partition", "start": 170.5, "end": 171.575}, {"text": "Consumers", "start": 171.575, "end": 172.45}, {"text": "in", "start": 172.45, "end": 172.537}, {"text": "a", "start": 172.537, "end": 172.6}, {"text": "consumer", "start": 172.6, "end": 173.15}, {"text": "group", "start": 173.15, "end": 173.5}, {"text": "split", "start": 173.5, "end": 173.85}, {"tex