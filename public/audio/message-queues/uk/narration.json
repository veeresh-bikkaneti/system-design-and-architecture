t": 148.988, "end": 149.188}, {"text": "a", "start": 149.188, "end": 149.25}, {"text": "partition", "start": 149.25, "end": 149.825}, {"text": "or", "start": 149.825, "end": 149.988}, {"text": "queue", "start": 149.988, "end": 150.25}, {"text": "not", "start": 150.25, "end": 150.475}, {"text": "globally", "start": 150.475, "end": 151.5}, {"text": "Kafka's", "start": 151.5, "end": 152.05}, {"text": "model", "start": 152.05, "end": 152.375}, {"text": "is", "start": 152.375, "end": 152.512}, {"text": "the", "start": 152.512, "end": 152.6}, {"text": "clearest", "start": 152.6, "end": 153.375}, {"text": "a", "start": 153.375, "end": 153.575}, {"text": "topic", "start": 153.575, "end": 153.938}, {"text": "is", "start": 153.938, "end": 154.05}, {"text": "split", "start": 154.05, "end": 154.338}, {"text": "into", "start": 154.338, "end": 154.55}, {"text": "partitions", "start": 154.55, "end": 155.275}, {"text": "each", "start": 155.275, "end": 155.588}, {"text": "an", "start": 155.588, "end": 155.675}, {"text": "ordered", "start": 155.675, "end": 156.0}, {"text": "log", "start": 156.0, "end": 156.675}, {"text": "messages", "start": 156.675, "end": 157.312}, {"text": "with", "start": 157.312, "end": 157.412}, {"text": "the", "start": 157.412, "end": 157.512}, {"text": "same", "start": 157.512, "end": 157.825}, {"text": "key", "start": 157.825, "end": 158.075}, {"text": "always", "start": 158.075, "end": 158.4}, {"text": "land", "start": 158.4, "end": 158.713}, {"text": "in", "start": 158.713, "end": 158.787}, {"text": "the", "start": 158.787, "end": 158.875}, {"text": "same", "start": 158.875, "end": 159.125}, {"text": "partition", "start": 159.125, "end": 160.275}, {"text": "Consumers", "start": 160.275, "end": 161.075}, {"text": "in", "start": 161.075, "end": 161.162}, {"text": "a", "start": 161.162, "end": 161.225}, {"text": "consumer", "start": 161.225, "end": 161.7}, {"text": "group", "start": 161.7, "end": 162.0}, {"text": "split", "start": 162.0, "end": 162.3}, {"text": "partitions", "start": 162.3, "end": 162.838}, {"text": "among", "start": 162.838, "end": 163.062}, {"text": "themselves", "start": 163.062, "end": 163.8}, {"text": "add", "start": 163.8, "end": 164.062}, {"text": "a", "start": 164.062, "end": 164.125}, {"text": "consumer", "start": 164.125, "end": 164.925}, {"text": "and", "start": 164.925, "end": 165.15}, {"text": "partitions", "start": 165.15, "end": 165.775}, {"text": "get", "start": 165.775, "end": 165.95}, {"text": "rebalanced", "start": 165.95, "end": 167.1}]}, {"index": 15, "kind": "prose", "text": "The catch: a partition is consumed by exactly one consumer in a group, so your parallelism is capped by your partition count. Pick too few partitions and you can't scale consumers; pick too many and rebalancing gets chatty. This is one of those decisions that's cheap to make early and painful to change later.", "start": 167.4, "end": 185.525, "words": [{"text": "The", "start": 167.65, "end": 167.725}, {"text": "catch", "start": 167.725, "end": 168.175}, {"text": "a", "start": 168.175, "end": 168.325}, {"text": "partition", "start": 168.325, "end": 168.787}, {"text": "is", "start": 168.787, "end": 168.875}, {"text": "consumed", "start": 168.875, "end": 169.375}, {"text": "by", "start": 169.375, "end": 169.55}, {"text": "exactly", "start": 169.55, "end": 170.05}, {"text": "one", "start": 170.05, "end": 170.275}, {"text": "consumer", "start": 170.275, "end": 170.763}, {"text": "in", "start": 170.763, "end": 170.838}, {"text": "a", "start": 170.838, "end": 170.9}, {"text": "group", "start": 170.9, "end": 171.5}, {"text": "so", "start": 171.5, "end": 171.75}, {"text": "your", "start": 171.75, "end": 171.875}, {"text": "parallelism", "start": 171.875, "end": 172.488}, {"text": "is", "start": 172.488, "end": 172.625}, {"text": "capped", "start": 172.625, "end": 172.95}, {"text": "by", "start": 172.95, "end": 173.125}, {"text": "your", "start": 173.125, "end": 173.25}, {"text": "partition", "start": 173.25, "end": 173