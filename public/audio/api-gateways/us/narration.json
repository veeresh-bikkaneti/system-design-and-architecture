": 286.662}, {"text": "the", "start": 286.662, "end": 286.787}, {"text": "single", "start": 286.787, "end": 287.15}, {"text": "front", "start": 287.15, "end": 287.375}, {"text": "door", "start": 287.375, "end": 287.95}, {"text": "one", "start": 287.95, "end": 288.325}, {"text": "address", "start": 288.325, "end": 288.85}, {"text": "one", "start": 288.85, "end": 289.15}, {"text": "auth", "start": 289.15, "end": 289.375}, {"text": "story", "start": 289.375, "end": 289.875}, {"text": "one", "start": 289.875, "end": 290.25}, {"text": "home", "start": 290.25, "end": 290.525}, {"text": "for", "start": 290.525, "end": 290.65}, {"text": "cross", "start": 290.65, "end": 291.3}, {"text": "cutting", "start": 291.3, "end": 291.3}, {"text": "concerns", "start": 291.3, "end": 292.15}]}, {"index": 23, "kind": "prose", "text": "Auth, rate limiting, request shaping, and observability belong in the gateway — not reimplemented in every service.", "start": 292.4, "end": 300.35, "words": [{"text": "Auth", "start": 292.7, "end": 293.05}, {"text": "rate", "start": 293.05, "end": 293.425}, {"text": "limiting", "start": 293.425, "end": 294.125}, {"text": "request", "start": 294.125, "end": 294.662}, {"text": "shaping", "start": 294.662, "end": 295.225}, {"text": "and", "start": 295.225, "end": 295.412}, {"text": "observability", "start": 295.412, "end": 296.275}, {"text": "belong", "start": 296.275, "end": 296.712}, {"text": "in", "start": 296.712, "end": 296.787}, {"text": "the", "start": 296.787, "end": 296.875}, {"text": "gateway", "start": 296.875, "end": 297.737}, {"text": "not", "start": 297.737, "end": 298.15}, {"text": "reimplemented", "start": 298.15, "end": 298.875}, {"text": "in", "start": 298.875, "end": 299.037}, {"text": "every", "start": 299.037, "end": 299.375}, {"text": "service", "start": 299.375, "end": 300.1}]}, {"index": 24, "kind": "prose", "text": "The BFF pattern tailors the edge per client type instead of forcing one contract on everyone.", "start": 300.35, "end": 3