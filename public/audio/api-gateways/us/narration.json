"end": 121.438}, {"text": "and", "start": 121.438, "end": 121.575}, {"text": "authorization", "start": 121.575, "end": 122.825}, {"text": "The", "start": 122.825, "end": 123.05}, {"text": "gateway", "start": 123.05, "end": 123.463}, {"text": "validates", "start": 123.463, "end": 124.05}, {"text": "tokens", "start": 124.05, "end": 124.812}, {"text": "JWTs", "start": 124.812, "end": 126.05}, {"text": "API", "start": 126.05, "end": 126.763}, {"text": "keys", "start": 126.763, "end": 127.25}, {"text": "OAuth", "start": 127.25, "end": 127.787}, {"text": "flows", "start": 127.787, "end": 128.225}, {"text": "once", "start": 128.225, "end": 128.875}, {"text": "then", "start": 128.875, "end": 129.225}, {"text": "forwards", "start": 129.225, "end": 129.662}, {"text": "the", "start": 129.662, "end": 129.75}, {"text": "request", "start": 129.75, "end": 130.287}, {"text": "with", "start": 130.287, "end": 130.412}, {"text": "the", "start": 130.412, "end": 130.512}, {"text": "caller's", "start": 130.512, "end": 130.963}, {"text": "identity", "start": 130.963, "end": 131.5}, {"text": "attached", "start": 131.5, "end": 132.287}, {"text": "often", "start": 132.287, "end": 132.787}, {"text": "as", "start": 132.787, "end": 132.95}, {"text": "headers", "start": 132.95, "end": 133.35}, {"text": "the", "start": 133.35, "end": 133.475}, {"text": "inner", "start": 133.475, "end": 133.738}, {"text": "services", "start": 133.738, "end": 134.3}, {"text": "trust", "start": 134.3, "end": 135.075}, {"text": "Your", "start": 135.075, "end": 135.375}, {"text": "eleven", "start": 135.375, "end": 135.8}, {"text": "microservices", "start": 135.8, "end": 136.775}, {"text": "never", "start": 136.775, "end": 137.075}, {"text": "each", "start": 137.075, "end": 137.3}, {"text": "implement", "start": 137.3, "end": 137.963}, {"text": "is", "start": 137.963, "end": 138.175}, {"text": "this", "start": 138.175, "end": 138.375}, {"text": "token", "start": 138.375, "end": 138.7}, {"text": "expired", "start": 138.