, "end": 204.812}, {"text": "the", "start": 204.812, "end": 205.05}, {"text": "expensive", "start": 205.05, "end": 205.65}, {"text": "handshake", "start": 205.65, "end": 206.225}, {"text": "happens", "start": 206.225, "end": 206.6}, {"text": "close", "start": 206.6, "end": 206.925}, {"text": "to", "start": 206.925, "end": 207.012}, {"text": "the", "start": 207.012, "end": 207.1}, {"text": "user", "start": 207.1, "end": 207.75}]}, {"index": 18, "kind": "prose", "text": "Cloudflare, CloudFront, Fastly, and Akamai all sell this. Nobody will ever thank you for the 80 milliseconds you shaved off their API call, but the conversion-rate graphs will.", "start": 208.0, "end": 219.75, "words": [{"text": "Cloudflare", "start": 208.25, "end": 208.9}, {"text": "CloudFront", "start": 208.9, "end": 209.775}, {"text": "Fastly", "start": 209.775, "end": 210.575}, {"text": "and", "start": 210.575, "end": 210.787}, {"text": "Akamai", "start": 210.787, "end": 211.312}, {"text": "all", "start": 211.312, "end": 211.562}, {"text": "sell", "start": 211.562, "end": 211.825}, {"text": "this", "start": 211.825, "end": 212.525}, {"text": "Nobody", "start": 212.525, "end": 213.1}, {"text": "will", "start": 213.1, "end": 213.275}, {"text": "ever", "start": 213.275, "end": 213.588}, {"text": "thank", "start": 213.588, "end": 213.875}, {"text": "you", "start": 213.875, "end": 214.025}, {"text": "for", "start": 214.025, "end": 214.137}, {"text": "the", "start": 214.137, "end": 214.287}, {"text": "80", "start": 214.287, "end": 214.575}, {"text": "milliseconds", "start": 214.575, "end": 215.175}, {"text": "you", "start": 215.175, "end": 215.363}, {"text": "shaved", "start": 215.363, "end": 215.775}, {"text": "off", "start": 215.775, "end": 216.0}, {"text": "their", "start": 216.0, "end": 216.188}, {"text": "API", "start": 216.188, "end": 216.762}, {"text": "call", "start": 216.762, "end": 217.375}, {"text": "but", "start": 217.375, "end": 217.613}, {"text": "the", "start": 217.613, "end": 217.7}, {"t